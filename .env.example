# ==============================================================================
# JobTrack Environment Variables Template
# DO NOT COMMIT ACTUAL SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend / Client Configuration (Public)
# These are exposed to the browser and safe to be public.
# Obtain from: Supabase Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Target Administrator Email (matches server-side RLS policy)
VITE_ADMIN_EMAIL=syedaman996455@gmail.com

# ------------------------------------------------------------------------------
# Backend / Serverless Function Configuration (Private)
# CONFIGURE THESE EXCLUSIVELY IN NETLIFY DASHBOARD:
# Site configuration -> Environment variables
# NEVER prefix these with VITE_ to prevent client-side bundle exposure!
# ------------------------------------------------------------------------------
# Resend API Key for sending transaction emails
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_secret_resend_api_key

# Destination email for admin notifications
ADMIN_NOTIFICATION_EMAIL=syedaman996455@gmail.com

# Verified sender email in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=JobTrack Alerts <onboarding@resend.dev>

# Supabase Service Role Key (ONLY if server-side admin verification is needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
